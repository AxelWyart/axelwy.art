{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/V2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/V2/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/V2/work/:slug",
      "destination": "/work/:slug",
      "permanent": true
    }
  ]
}
